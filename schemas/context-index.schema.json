{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Agent Context Index",
  "$defs": {
    "baseEntry": {
      "type": "object",
      "required": ["id", "path", "summary", "tags", "priority"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\./).+\\.md$" },
        "summary": { "type": "string", "minLength": 10, "maxLength": 240 },
        "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" } },
        "priority": { "enum": ["critical", "high", "medium", "low"] }
      }
    },
    "v1Entry": {
      "allOf": [
        { "$ref": "#/$defs/baseEntry" },
        { "type": "object", "additionalProperties": false, "properties": {
          "id": true, "path": true, "summary": true, "tags": true, "priority": true
        } }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator", "note"],
      "properties": {
        "type": { "enum": ["repository", "external", "decision"] },
        "locator": { "type": "string", "minLength": 1, "maxLength": 500 },
        "note": { "type": "string", "minLength": 5, "maxLength": 300 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 200 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrievedAt": { "type": "string", "format": "date" },
        "publishedAt": { "type": "string", "format": "date" },
        "decidedAt": { "type": "string", "format": "date" },
        "decisionId": { "type": "string", "minLength": 1, "maxLength": 200 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "enum": ["repository", "decision"] } } }, "then": { "required": ["sha256"] } },
        { "if": { "properties": { "type": { "const": "external" } } }, "then": { "properties": { "locator": { "type": "string", "format": "uri", "pattern": "^https://" } } } }
      ]
    },
    "v2Entry": {
      "allOf": [
        { "$ref": "#/$defs/baseEntry" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "scope", "confidence", "status", "recordedAt", "lastVerifiedAt"],
          "properties": {
            "id": true, "path": true, "summary": true, "tags": true, "priority": true,
            "kind": { "enum": ["architecture", "standard", "project", "decision", "constraint", "operation", "domain", "pitfall", "imported"] },
            "scope": { "type": "string", "minLength": 2, "maxLength": 120 },
            "confidence": { "enum": ["high", "medium", "low", "unknown"] },
            "status": { "enum": ["active", "conflicted", "superseded"] },
            "recordedAt": { "type": "string", "format": "date" },
            "lastVerifiedAt": { "type": "string", "format": "date" },
            "reviewAfter": { "type": "string", "format": "date" },
            "aliases": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
            "related": { "$ref": "#/$defs/relations" },
            "supersedes": { "$ref": "#/$defs/relations" },
            "supersededBy": { "$ref": "#/$defs/relations" },
            "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/evidence" } }
          }
        }
      ]
    },
    "relations": { "type": "array", "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
  },
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["version", "entries"],
      "properties": { "$schema": { "type": "string" }, "version": { "const": 1 }, "entries": { "type": "array", "items": { "$ref": "#/$defs/v1Entry" } } }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["version", "entries"],
      "properties": { "$schema": { "type": "string" }, "version": { "const": 2 }, "entries": { "type": "array", "items": { "$ref": "#/$defs/v2Entry" } } }
    }
  ]
}
